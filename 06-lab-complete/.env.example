# Copy thành .env (đã nằm trong .gitignore):  cp .env.example .env
# Chỉ để giá trị mẫu — KHÔNG ghi key thật vào file này.

PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Bắt buộc, tự điền khi chạy: để trống thì agent từ chối mọi request. Tạo key: openssl rand -hex 16
AGENT_API_KEY=

# Trong docker compose, REDIS_URL được đặt thành redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
# Tuỳ chọn: bỏ trống = không giới hạn theo tháng
MONTHLY_BUDGET_USD=10.0
